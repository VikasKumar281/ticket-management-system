# Copy this file to .env for local reference (the app reads real env vars,
# not this file directly — use `export $(cat .env | xargs)` or your
# deployment platform's env var settings to actually apply these).

# Port the HTTP server listens on. Defaults to 8080 if unset.
PORT=8080

# Secret key used to sign and verify JWTs. MUST be set to a long, random
# value in any non-local environment. If unset, the app falls back to an
# insecure development default and logs a warning.
JWT_SECRET=change-this-to-a-long-random-secret-in-production
